# Apify — for scraping Instagram Reels
# Get your token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Your own Instagram username (no @)
OWN_INSTAGRAM_USERNAME=your_instagram_username

# Competitor handles to track (comma-separated, no @)
COMPETITOR_HANDLES=competitor1,competitor2,competitor3

# Optional creator profile used in AI prompts and the sidebar
CREATOR_DISPLAY_NAME=Your Name
CREATOR_BRAND_NAME=CreatorOS
CREATOR_CONTENT_NICHE=short-form educational content
CREATOR_LANGUAGE_STYLE=clear, actionable, audience-native language
CREATOR_AUDIENCE=people who want practical creator advice they can use immediately
CREATOR_CALENDAR_FOCUS=practical content ideas for your niche

# How many of your own reels to pull (recommended: 30-50)
OWN_REELS_LIMIT=40

# Local AI — Ollama runs all analysis and calendar generation
# Ollama must be running: systemctl start ollama
OLLAMA_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=qwen3:14b

# Whisper model size for local transcription: tiny, base, small, medium, large
# larger = more accurate but slower. "base" is a good default.
WHISPER_MODEL=base

# Optional. When set, write/job API routes require Authorization: Bearer <token>
API_AUTH_TOKEN=change_me_for_production

# Used by scripts/run-analysis-job.mjs and systemd worker units
CREATOR_DASHBOARD_URL=http://127.0.0.1:3000
